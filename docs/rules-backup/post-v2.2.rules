// Backup regole pubblicate — progetto garageos-879bc
// ruleset: projects/garageos-879bc/rulesets/63f90b2e-d15c-4a1f-a962-75c640c8f220
// salvato: 2026-11-07T12:04:02.734Z
rules_version = '2';
// GarageOS — regole Firestore (hotfix sicurezza v2.2)
// Test: tests/rules (npm test) — ogni modifica qui va accompagnata da test.
//
// Modello:
//   users/{uid}                         puntatore al garage attivo
//   garages/{gid}                       gid == uid del proprietario
//     memberUids: string[]              FONTE DI VERITÀ per l'accesso
//     memberInfo: { [uid]: {email,name,photo,joinedAt,inviteId} }  profilo dei membri (chiavi ⊆ memberUids)
//     members: [...]                    LEGACY v1/v2.1 (solo lettura per i membri, il proprietario può ripulirlo)
//     vehicles/{id}, tires/{id}, mechs/{id}
//   invites/{token}                     token = 256 bit casuali in esadecimale, scadenza ≤ 7 giorni, uso singolo
//
// Compatibilità con i dati esistenti: in UPDATE si validano solo i campi AGGIUNTI o MODIFICATI,
// così un documento legacy con campi sconosciuti, null o valori fuori misura resta modificabile
// finché quei campi non vengono toccati. In CREATE la validazione è completa.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── helper generici ─────────
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function gPath(gid) { return /databases/$(database)/documents/garages/$(gid); }
    function iPath(token) { return /databases/$(database)/documents/invites/$(token); }

    function isOwner(gid) { return signedIn() && request.auth.uid == gid; }
    function isMember(gid) {
      return isOwner(gid)
        || (signedIn() && request.auth.uid in get(gPath(gid)).data.get('memberUids', []));
    }

    // ID generati da Firestore (20 car.) o legacy uid() della v1/v2.1 ([a-z0-9]); niente apici/virgolette
    function validId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,40}$'); }
    function str(v, max) { return v is string && v.size() <= max; }
    function reqStr(m, k, max) { return k in m && m[k] is string && m[k].size() > 0 && m[k].size() <= max; }
    function optStr(m, k, max) { return !(k in m) || m[k] == null || str(m[k], max); }
    // km/costi/anno: oggi stringhe (dati legacy), number dalla migrazione di Fase 4
    function optNum(m, k) { return !(k in m) || m[k] == null || m[k] is number || str(m[k], 15); }
    function optDate(m, k) {
      return !(k in m) || m[k] == null || m[k] == ''
        || (m[k] is string && m[k].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function optTs(m, k) { return !(k in m) || m[k] == null || m[k] is timestamp || str(m[k], 40); }
    function optBool(m, k) { return !(k in m) || m[k] == null || m[k] is bool; }

    // chiavi aggiunte o modificate da questa scrittura (le rimozioni non contano)
    function touched() {
      let d = request.resource.data.diff(resource.data);
      return d.addedKeys().union(d.changedKeys());
    }

    // ───────── users ─────────
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid && validUser(uid, request.resource.data);
    }
    function validUser(uid, d) {
      return d.keys().hasOnly(['garageId', 'email', 'name', 'updatedAt'])
        && validId(d.garageId)
        // si può puntare solo al proprio garage o a uno di cui si è membro (dopo questa scrittura)
        && (d.garageId == uid || uid in getAfter(gPath(d.garageId)).data.get('memberUids', []))
        && optStr(d, 'email', 254) && optStr(d, 'name', 100) && optTs(d, 'updatedAt');
    }

    // ───────── garages ─────────
    match /garages/{gid} {
      allow get: if isMember(gid);
      allow list: if false;                       // niente scansioni globali
      allow create: if isOwner(gid) && validGarageCreate();
      allow update: if ownerUpdate(gid) || memberLeave(gid) || inviteJoin(gid);
      allow delete: if false;                     // nessuna UI la prevede: solo da console

      match /vehicles/{id} {
        allow read, delete: if isMember(gid);
        allow create: if isMember(gid) && validId(id)
          && request.resource.data.keys().hasOnly(vehicleKeys())
          && vehicleOk(request.resource.data, vehicleKeys());
        allow update: if isMember(gid)
          && touched().hasOnly(vehicleKeys())
          && vehicleOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
      }
      match /tires/{id} {
        allow read, delete: if isMember(gid);
        allow create: if isMember(gid) && validId(id)
          && request.resource.data.keys().hasOnly(tireKeys())
          && tireOk(request.resource.data, tireKeys());
        allow update: if isMember(gid)
          && touched().hasOnly(tireKeys())
          && tireOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
      }
      match /mechs/{id} {
        allow read, delete: if isMember(gid);
        allow create: if isMember(gid) && validId(id)
          && request.resource.data.keys().hasOnly(mechKeys())
          && mechOk(request.resource.data, mechKeys());
        allow update: if isMember(gid)
          && touched().hasOnly(mechKeys())
          && mechOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
      }
      // qualunque altra sottocollezione: negata (default)
    }

    function validGarageCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'ownerEmail', 'ownerPhoto', 'garageName',
                               'members', 'memberUids', 'memberInfo', 'createdAt'])
        && d.ownerUid == request.auth.uid
        && optStr(d, 'ownerName', 100) && optStr(d, 'ownerEmail', 254)
        && optStr(d, 'ownerPhoto', 2048) && optStr(d, 'garageName', 40) && optTs(d, 'createdAt')
        && d.get('memberUids', []) == []
        && d.get('memberInfo', {}) == {}
        && d.get('members', []) == [];
    }

    // Proprietario: può modificare il garage ma non cederlo; su memberUids può SOLO togliere
    // (si entra esclusivamente tramite invito); memberInfo resta sempre ⊆ memberUids.
    function ownerUpdate(gid) {
      let before = resource.data;
      let after = request.resource.data;
      let ks = touched();
      return isOwner(gid)
        && !('ownerUid' in after.diff(before).affectedKeys())
        && ks.hasOnly(['ownerName', 'ownerEmail', 'ownerPhoto', 'garageName', 'members', 'memberUids', 'memberInfo'])
        && (!('garageName' in ks) || optStr(after, 'garageName', 40))
        && (!('ownerName' in ks) || optStr(after, 'ownerName', 100))
        && (!('ownerEmail' in ks) || optStr(after, 'ownerEmail', 254))
        && (!('ownerPhoto' in ks) || optStr(after, 'ownerPhoto', 2048))
        && (!('members' in ks) || (after.members is list && after.members.size() <= 50))
        && after.get('memberUids', []) is list
        && before.get('memberUids', []).toSet().hasAll(after.get('memberUids', []))
        && after.get('memberInfo', {}) is map
        && after.get('memberInfo', {}).keys().hasOnly(after.get('memberUids', []));
    }

    // Membro: può togliere SOLO sé stesso (memberUids + il proprio memberInfo), nient'altro.
    function memberLeave(gid) {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let bu = before.get('memberUids', []);
      return signedIn() && uid != gid && uid in bu
        && after.diff(before).affectedKeys().hasOnly(['memberUids', 'memberInfo'])
        && after.get('memberUids', []) == bu.removeAll([uid])
        && !(uid in after.get('memberInfo', {}))
        && after.get('memberInfo', {}).diff(before.get('memberInfo', {})).affectedKeys().hasOnly([uid]);
    }

    // Ingresso: solo aggiungendo sé stesso, con un invito valido consumato NELLO STESSO batch.
    function inviteJoin(gid) {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let bu = before.get('memberUids', []);
      let info = after.get('memberInfo', {});
      return signedIn() && verified() && uid != gid && !(uid in bu)
        && bu.size() < 20
        && after.diff(before).affectedKeys().hasOnly(['memberUids', 'memberInfo'])
        && after.get('memberUids', []) == bu.concat([uid])
        && uid in info
        && info.diff(before.get('memberInfo', {})).affectedKeys().hasOnly([uid])
        && validJoinInfo(info[uid], gid);
    }
    function validJoinInfo(m, gid) {
      return m is map
        && m.keys().hasOnly(['email', 'name', 'photo', 'joinedAt', 'inviteId'])
        && m.email == myEmail()
        && optStr(m, 'name', 100) && optStr(m, 'photo', 2048)
        && m.joinedAt == request.time
        && str(m.inviteId, 64) && m.inviteId.matches('^[a-f0-9]{64}$')
        && inviteConsumedNow(m.inviteId, gid);
    }
    function inviteConsumedNow(token, gid) {
      let inv = get(iPath(token)).data;            // stato PRIMA del batch
      let invAfter = getAfter(iPath(token)).data;  // stato DOPO il batch
      return inv.garageId == gid && inv.email == myEmail()
        && inv.usedAt == null && inv.expiresAt > request.time
        && invAfter.usedBy == request.auth.uid && invAfter.usedAt == request.time;
    }

    // ───────── invites ─────────
    match /invites/{token} {
      // il token è il segreto: GET puntuale solo per il proprietario o per l'email invitata;
      // LIST solo per il proprietario e solo sui propri inviti (query where garageId == uid)
      allow get: if signedIn() && (resource.data.garageId == request.auth.uid || resource.data.email == myEmail());
      allow list: if signedIn() && resource.data.garageId == request.auth.uid;
      allow create: if validInviteCreate(token);
      allow update: if inviteConsume();
      allow delete: if signedIn() && resource.data.garageId == request.auth.uid;   // revoca
    }
    function validInviteCreate(token) {
      let d = request.resource.data;
      return signedIn()
        && token.matches('^[a-f0-9]{64}$')
        && d.keys().hasOnly(['garageId', 'email', 'createdBy', 'createdAt', 'expiresAt',
                             'usedAt', 'usedBy', 'garageName', 'invitedByName'])
        && d.keys().hasAll(['garageId', 'email', 'createdBy', 'createdAt', 'expiresAt', 'usedAt', 'usedBy'])
        && d.garageId == request.auth.uid && d.createdBy == request.auth.uid
        && exists(gPath(request.auth.uid))
        && str(d.email, 254) && d.email == d.email.lower()
        && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.email != myEmail()
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(7, 'd')
        && d.usedAt == null && d.usedBy == null
        && optStr(d, 'garageName', 40) && optStr(d, 'invitedByName', 100);
    }
    function inviteConsume() {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn() && verified()
        && before.email == myEmail()
        && before.usedAt == null && before.expiresAt > request.time
        && after.diff(before).affectedKeys().hasOnly(['usedAt', 'usedBy'])
        && after.usedAt == request.time && after.usedBy == request.auth.uid
        // chi è già membro non può "bruciare" inviti
        && !(request.auth.uid in get(gPath(before.garageId)).data.get('memberUids', []))
        // si consuma solo entrando davvero nel garage nello stesso batch
        && request.auth.uid in getAfter(gPath(before.garageId)).data.get('memberUids', []);
    }

    // ───────── validazione documenti ─────────
    // ks = chiavi da validare: tutte in create, solo quelle toccate in update
    function vehicleKeys() {
      return ['plate', 'model', 'type', 'year', 'km', 'kmDate', 'tagliandoInt',
              'bollo', 'bolloCost', 'revisione', 'revisioneCost', 'assicurazione', 'assicurazioneCost',
              'assicurazioneCompany', 'note', 'frozen', 'frozenAt', 'createdAt', 'addedBy', 'updatedAt'];
    }
    function vehicleOk(d, ks) {
      return (!('plate' in ks) || reqStr(d, 'plate', 15))
        && (!('model' in ks) || reqStr(d, 'model', 100))
        && (!('type' in ks) || !('type' in d) || d.type == null || d.type in ['auto', 'moto', 'suv', 'furgone'])
        && (!('year' in ks) || optNum(d, 'year'))
        && (!('km' in ks) || optNum(d, 'km'))
        && (!('kmDate' in ks) || optDate(d, 'kmDate'))
        && (!('tagliandoInt' in ks) || optNum(d, 'tagliandoInt'))
        && (!('bollo' in ks) || optDate(d, 'bollo'))
        && (!('bolloCost' in ks) || optNum(d, 'bolloCost'))
        && (!('revisione' in ks) || optDate(d, 'revisione'))
        && (!('revisioneCost' in ks) || optNum(d, 'revisioneCost'))
        && (!('assicurazione' in ks) || optDate(d, 'assicurazione'))
        && (!('assicurazioneCost' in ks) || optNum(d, 'assicurazioneCost'))
        && (!('assicurazioneCompany' in ks) || optStr(d, 'assicurazioneCompany', 100))
        && (!('note' in ks) || optStr(d, 'note', 2000))
        && (!('frozen' in ks) || optBool(d, 'frozen'))
        && (!('frozenAt' in ks) || optTs(d, 'frozenAt'))
        && (!('createdAt' in ks) || optTs(d, 'createdAt'))
        && (!('updatedAt' in ks) || optTs(d, 'updatedAt'))
        && (!('addedBy' in ks) || optStr(d, 'addedBy', 254));
    }
    function tireKeys() {
      return ['vehicleId', 'season', 'date', 'km', 'kmNext', 'brand', 'size', 'note', 'createdAt', 'updatedAt'];
    }
    function tireOk(d, ks) {
      return (!('vehicleId' in ks) || ('vehicleId' in d && validId(d.vehicleId)))
        && (!('season' in ks) || ('season' in d && d.season in ['invernale', 'estivo', 'allseason']))
        && (!('date' in ks) || optDate(d, 'date'))
        && (!('km' in ks) || optNum(d, 'km'))
        && (!('kmNext' in ks) || optNum(d, 'kmNext'))
        && (!('brand' in ks) || optStr(d, 'brand', 60))
        && (!('size' in ks) || optStr(d, 'size', 40))
        && (!('note' in ks) || optStr(d, 'note', 2000))
        && (!('createdAt' in ks) || optTs(d, 'createdAt'))
        && (!('updatedAt' in ks) || optTs(d, 'updatedAt'));
    }
    function mechKeys() {
      return ['vehicleId', 'type', 'date', 'km', 'cost', 'garage', 'note', 'createdAt', 'updatedAt', 'addedBy'];
    }
    function mechOk(d, ks) {
      return (!('vehicleId' in ks) || ('vehicleId' in d && validId(d.vehicleId)))
        && (!('type' in ks) || ('type' in d && d.type is string && d.type.matches('^[A-Za-z0-9_]{1,40}$')))
        && (!('date' in ks) || optDate(d, 'date'))
        && (!('km' in ks) || optNum(d, 'km'))
        && (!('cost' in ks) || optNum(d, 'cost'))
        && (!('garage' in ks) || optStr(d, 'garage', 100))
        && (!('note' in ks) || optStr(d, 'note', 2000))
        && (!('createdAt' in ks) || optTs(d, 'createdAt'))
        && (!('updatedAt' in ks) || optTs(d, 'updatedAt'))
        && (!('addedBy' in ks) || optStr(d, 'addedBy', 254));
    }
  }
}
